# Variáveis de ambiente do EcoTrack.
# Copie para .env (cp .env.example .env) e ajuste. O .env está no .gitignore.
# Sem o .env o docker-compose.yml usa os valores padrão para rodar local.

# imagem da API (local: ecotrack-api:local | pipeline: ghcr.io/<owner>/ecotrack-api:sha-xxxxxxx)
ECOTRACK_IMAGE=ecotrack-api:local

# ambiente exibido em /actuator/info e na página inicial: local | staging | producao
APP_ENV=local
# profile do Spring: default | staging | prod
SPRING_PROFILES_ACTIVE=default
# porta publicada no host
APP_PORT=8080

# banco Oracle (usuário da aplicação e senha do SYS/SYSTEM)
DB_USER=ECOTRACK
DB_PASSWORD=troque-esta-senha
ORACLE_ADMIN_PASSWORD=troque-esta-senha

# usuários da API (Basic Auth)
ECOTRACK_ADMIN_USER=admin@ecotrack.com
ECOTRACK_ADMIN_PASSWORD=troque-esta-senha
ECOTRACK_USER=user@ecotrack.com
ECOTRACK_USER_PASSWORD=troque-esta-senha

# opcionais
SWAGGER_ENABLED=true
SHOW_SQL=false
APP_CPUS=1.0
APP_MEM_LIMIT=768M
