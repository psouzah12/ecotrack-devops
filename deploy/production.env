# Configuração NÃO secreta do ambiente de produção.
# Senhas vêm dos secrets do GitHub (Environment "production") ou são geradas
# pelo scripts/deploy.sh e guardadas em ~/.ecotrack/production.secrets.env
COMPOSE_PROJECT_NAME=ecotrack-production
APP_ENV=producao
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8082
# Swagger mantido ligado para a demonstração do trabalho.
# Numa produção real ficaria false.
SWAGGER_ENABLED=true
SHOW_SQL=false
APP_CPUS=1.5
APP_MEM_LIMIT=1G
DB_USER=ECOTRACK
ECOTRACK_ADMIN_USER=admin@ecotrack.com
ECOTRACK_USER=user@ecotrack.com
