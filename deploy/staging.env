# Configuração NÃO secreta do ambiente de staging (homologação).
# Senhas vêm dos secrets do GitHub (Environment "staging") ou são geradas
# pelo scripts/deploy.sh e guardadas em ~/.ecotrack/staging.secrets.env
COMPOSE_PROJECT_NAME=ecotrack-staging
APP_ENV=staging
SPRING_PROFILES_ACTIVE=staging
APP_PORT=8081
SWAGGER_ENABLED=true
SHOW_SQL=false
APP_CPUS=1.0
APP_MEM_LIMIT=768M
DB_USER=ECOTRACK
ECOTRACK_ADMIN_USER=admin@ecotrack.com
ECOTRACK_USER=user@ecotrack.com
